# Console (REPL) on the XIAO USB-C port
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y

# 1.5 MB app partition for the Wi-Fi stack
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# 1 ms scheduler tick
CONFIG_FREERTOS_HZ=1000

# Power management: frequency scaling and automatic light sleep between Wi-Fi wake-ups
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_PM_SLP_IRAM_OPT=y
CONFIG_PM_RTOS_IDLE_OPT=y
CONFIG_PM_SLP_DISABLE_GPIO=y
CONFIG_PM_POWER_DOWN_CPU_IN_LIGHT_SLEEP=y
CONFIG_PM_POWER_DOWN_PERIPHERAL_IN_LIGHT_SLEEP=y
CONFIG_ESP_WIFI_SLP_IRAM_OPT=y
CONFIG_ESP_PHY_MAC_BB_PD=y

# Join hidden APs on passive-scan (DFS) channels such as 5 GHz channel 60
CONFIG_ESP_WIFI_PASSIVE_HIDDEN_AP_SUPPORT=y

# Same network stack settings as the ESP-IDF iTWT example
CONFIG_LWIP_ESP_GRATUITOUS_ARP=n
CONFIG_LWIP_IPV6=n
CONFIG_LWIP_DHCP_COARSE_TIMER_SECS=10
CONFIG_ESP_WIFI_ENABLE_WIFI_RX_STATS=n
CONFIG_ESP_WIFI_ENABLE_WIFI_TX_STATS=n
