# Console (REPL) on the XIAO USB-C port
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y

# Two 1.5 MB OTA slots and a FAT storage partition; table chosen per flash size
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Long file names on the storage partition
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

CONFIG_HTTPD_MAX_URI_LEN=512
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# Join hidden APs on passive-scan (DFS) channels
CONFIG_ESP_WIFI_PASSIVE_HIDDEN_AP_SUPPORT=y
